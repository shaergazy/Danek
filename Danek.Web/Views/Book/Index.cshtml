@model List<Book>

<div class="container">
    <div class="row pt-4 pb-3">
        <div class="col-6">
            <h2 class="text-primary">
                Book List
            </h2>
        </div>
        <div class="col-6 text-end">
            <a asp-controller="Book" asp-action="Add" class="btn btn-primary">
                <i class="bi bi-plus-circle-dotted"></i> Add New Book
            </a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Intro</th>
                <th>Quantity</th>
                <th>Created At</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var obj in Model.OrderBy(b => b.Title))
            {
                <tr>
                    <td>@obj.Title</td>
                    <td>@obj.Author</td>
                    <td>@obj.Intro</td>
                    <td>@obj.Quantity</td>
                    <td>@obj.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Book"
                               asp-action="Edit"
                               asp-route-id="@obj.Id"
                               class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>

                            <a asp-controller="Book"
                               asp-action="Delete"
                               asp-route-id="@obj.Id"
                               class="btn btn-danger mx-2">
                                <i class="bi bi-trash3-fill"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
