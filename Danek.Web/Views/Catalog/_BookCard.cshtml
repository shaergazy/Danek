@model Danek.Web.Models.Catalog.BookCardViewModel

<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Title</h5>
        <h6 class="card-subtitle mb-2 text-muted">@Model.Author</h6>
        <p class="card-text flex-grow-1">@Model.Intro</p>
        <div class="mt-3 d-flex justify-content-between align-items-center">
            <span class="badge @(Model.InStock ? "bg-success" : "bg-secondary")">
                @(Model.InStock ? "В наличии" : "Нет в наличии")
            </span>
            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                Подробнее
            </a>
        </div>
    </div>
</div>
