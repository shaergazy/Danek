@using Danek.Web.Models.Users
@model UserListResponse
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-people"></i> Управление пользователями</h1>
        <div>
            <a asp-action="Create" class="btn btn-primary me-2">
                <i class="bi bi-person-plus"></i> Создать пользователя
            </a>
            <a asp-action="Export" class="btn btn-outline-secondary">
                <i class="bi bi-download"></i> Экспорт
            </a>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Поиск по email, имени..."
                           value="@ViewBag.Filter.SearchTerm">
                </div>
                <div class="col-md-3">
                    <select name="role" class="form-select">
                        <option value="">Все роли</option>
                        @foreach (var role in ViewBag.ViewableRoles)
                        {
                            <option value="@role" selected="@(ViewBag.Filter.Role == role)">@role</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="isActive" class="form-select">
                        <option value="">Все статусы</option>
                        <option value="true" selected="@(ViewBag.Filter.IsActive == true)">Активные</option>
                        <option value="false" selected="@(ViewBag.Filter.IsActive == false)">Неактивные</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-funnel"></i> Фильтр
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Сброс
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Таблица пользователей -->
    <div class="card">
        <div class="card-body">
            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Имя</th>
                                <th>Email</th>
                                <th>Telegram</th>
                                <th>Роли</th>
                                <th>Статус</th>
                                <th>Создан</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.FullName</strong>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.TelegramUsername))
                                        {
                                            <span class="badge bg-info">@user.TelegramUsername</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge @(role == "SuperAdmin" ? "bg-danger" : role == "Admin" ? "bg-warning" : "bg-secondary") me-1">
                                                @role
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Активен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Неактивен</span>
                                        }
                                    </td>
                                    <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@user.Id"
                                               class="btn btn-outline-info" title="Просмотр">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@user.Id"
                                               class="btn btn-outline-primary" title="Редактировать">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-warning toggle-active-btn"
                                                    data-user-id="@user.Id"
                                                    title="@(user.IsActive ? "Деактивировать" : "Активировать")">
                                                <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                            </button>
                                            @if (ViewBag.IsSuperAdmin)
                                            {
                                                <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                                      onsubmit="return confirm('Вы уверены, что хотите удалить этого пользователя?')">
                                                    <button type="submit" class="btn btn-outline-danger" title="Удалить">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Пагинация -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.Page - 1)"
                                   asp-route-searchTerm="@ViewBag.Filter.SearchTerm"
                                   asp-route-role="@ViewBag.Filter.Role"
                                   asp-route-isActive="@ViewBag.Filter.IsActive">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-searchTerm="@ViewBag.Filter.SearchTerm"
                                       asp-route-role="@ViewBag.Filter.Role"
                                       asp-route-isActive="@ViewBag.Filter.IsActive">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@(Model.Page + 1)"
                                   asp-route-searchTerm="@ViewBag.Filter.SearchTerm"
                                   asp-route-role="@ViewBag.Filter.Role"
                                   asp-route-isActive="@ViewBag.Filter.IsActive">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }

                <div class="text-muted text-center mt-3">
                    Показано @Model.Users.Count из @Model.TotalCount пользователей
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-1 text-muted"></i>
                    <h4 class="mt-3">Пользователи не найдены</h4>
                    <p class="text-muted">Попробуйте изменить параметры фильтра</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Активация/деактивация пользователя
        document.querySelectorAll('.toggle-active-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const userId = this.dataset.userId;

                fetch(`@Url.Action("ToggleActive", "User")/${userId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка');
                });
            });
        });

        // Изменение пароля (модальное окно)
        function changePassword(userId) {
            const newPassword = prompt('Введите новый пароль (минимум 6 символов):');
            if (newPassword && newPassword.length >= 6) {
                fetch(`@Url.Action("ChangePassword", "User")/${userId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify({ newPassword: newPassword })
                })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка');
                });
            } else if (newPassword) {
                alert('Пароль должен содержать минимум 6 символов');
            }
        }
    </script>
}