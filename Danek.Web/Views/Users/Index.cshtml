@using Danek.Web.Models.Users
@model UserListResponse
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container-fluid mt-4">
    <!-- Заголовок с кнопками действий -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">
                <i class="bi bi-people me-2"></i>Управление пользователями
            </h1>
            <p class="text-muted mb-0">Всего пользователей: <span id="totalCount">@Model.TotalCount</span></p>
        </div>
        <div class="btn-group">
            <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-plus-circle me-1"></i>Действия
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" asp-action="Create">
                        <i class="bi bi-person-plus me-2"></i>Создать пользователя
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="#" id="exportBtn">
                        <i class="bi bi-download me-2"></i>Экспорт в Excel
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a class="dropdown-item text-success" href="#" id="activateSelectedBtn">
                        <i class="bi bi-person-check me-2"></i>Активировать выбранных
                    </a>
                </li>
                <li>
                    <a class="dropdown-item text-warning" href="#" id="deactivateSelectedBtn">
                        <i class="bi bi-person-x me-2"></i>Деактивировать выбранных
                    </a>
                </li>
                @if (ViewBag.IsSuperAdmin)
                {
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" href="#" id="deleteSelectedBtn">
                            <i class="bi bi-trash me-2"></i>Удалить выбранных
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Карточка с таблицей -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white border-0 pt-3 pb-0">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" id="searchInput"
                               placeholder="Поиск по email, имени, фамилии...">
                    </div>
                </div>
                <div class="col-md-4 mt-2 mt-md-0">
                    <div class="d-flex gap-2">
                        <select class="form-select form-select-sm" id="roleFilter">
                            <option value="">Все роли</option>
                            @foreach (var role in ViewBag.ViewableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <select class="form-select form-select-sm" id="statusFilter">
                            <option value="">Все статусы</option>
                            <option value="active">Активные</option>
                            <option value="inactive">Неактивные</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <!-- Таблица с DataTables -->
            <div class="table-responsive">
                <table id="usersTable" class="table table-hover table-striped mb-0" style="width:100%">
                    <thead>
                        <tr>
                            <th width="20">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="selectAll">
                                </div>
                            </th>
                            <th>Пользователь</th>
                            <th>Контакты</th>
                            <th>Роли</th>
                            <th>Статус</th>
                            <th>Дата создания</th>
                            <th>Последний вход</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr data-user-id="@user.Id">
                                <td>
                                    <div class="form-check">
                                        <input class="form-check-input user-checkbox" type="checkbox" value="@user.Id">
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm me-3">
                                            <div class="avatar-title bg-primary bg-opacity-10 text-primary rounded-circle">
                                                @if (!string.IsNullOrEmpty(user.FirstName))
                                                {
                                                    @user.FirstName[0]
                                                }
                                                else if (!string.IsNullOrEmpty(user.Email))
                                                {
                                                    @user.Email[0]
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person"></i>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@user.FullName</h6>
                                            <small class="text-muted">@user.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.TelegramUsername))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-telegram text-primary"></i>
                                            <span>@user.TelegramUsername</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge @GetRoleBadgeClass(role)">
                                                @role
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                            <i class="bi bi-check-circle me-1"></i>Активен
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                            <i class="bi bi-x-circle me-1"></i>Неактивен
                                        </span>
                                    }
                                </td>
                                <td data-order="@user.CreatedAt.ToString("yyyyMMddHHmmss")">
                                    @user.CreatedAt.ToString("dd.MM.yyyy")
                                    <small class="d-block text-muted">@user.CreatedAt.ToString("HH:mm")</small>
                                </td>
                                <td data-order="@(user.LastLoginAt?.ToString("yyyyMMddHHmmss") ?? "0")">
                                    @if (user.LastLoginAt.HasValue)
                                    {
                                        @user.LastLoginAt.Value.ToString("dd.MM.yyyy")
                                        <small class="d-block text-muted">@user.LastLoginAt.Value.ToString("HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-light dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-gear"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-action="Details" asp-route-id="@user.Id">
                                                    <i class="bi bi-eye me-2"></i>Просмотр
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@user.Id">
                                                    <i class="bi bi-pencil me-2"></i>Редактировать
                                                </a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="#" onclick="changePassword('@user.Id')">
                                                    <i class="bi bi-key me-2"></i>Сменить пароль
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a class="dropdown-item @(user.IsActive ? "text-warning" : "text-success")"
                                                   href="#" onclick="toggleUserActive('@user.Id', @user.IsActive.ToString().ToLower())">
                                                    <i class="bi @(user.IsActive ? "bi-person-x" : "bi-person-check") me-2"></i>
                                                    @(user.IsActive ? "Деактивировать" : "Активировать")
                                                </a>
                                            </li>
                                            @if (ViewBag.IsSuperAdmin)
                                            {
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger"
                                                       href="#" onclick="deleteUser('@user.Id', '@user.FullName')">
                                                        <i class="bi bi-trash me-2"></i>Удалить
                                                    </a>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white border-0 pt-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center">
                        <span class="me-2">Выбрано:</span>
                        <span id="selectedCount" class="badge bg-primary">0</span>
                        <div class="btn-group ms-3" id="selectedActions" style="display: none;">
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="activateSelected()">
                                <i class="bi bi-person-check"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning" onclick="deactivateSelected()">
                                <i class="bi bi-person-x"></i>
                            </button>
                            @if (ViewBag.IsSuperAdmin)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteSelected()">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSelection()">
                                <i class="bi bi-x"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="text-muted">
                        Показано <span id="shownCount">@Model.Users.Count</span> из <span id="totalCountFooter">@Model.TotalCount</span> записей
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения удаления -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Подтверждение удаления</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Вы уверены, что хотите удалить пользователя <strong id="deleteUserName"></strong>?</p>
                <p class="text-danger small">Это действие нельзя отменить!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Удалить</button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "SuperAdmin" => "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25",
            "Admin" => "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25",
            "Moderator" => "bg-info bg-opacity-10 text-info border border-info border-opacity-25",
            _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25"
        };
    }
}

@section Styles {
    <style>
        .avatar-sm {
            width: 36px;
            height: 36px;
        }

        .avatar-title {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 1rem;
        }

        .dataTables_wrapper .dataTables_filter {
            display: none;
        }

        .dataTables_length select {
            width: auto !important;
            display: inline-block !important;
        }

        table.dataTable tbody tr.selected {
            background-color: rgba(13, 110, 253, 0.1) !important;
        }

        .dt-button-collection {
            border: 1px solid #dee2e6;
            border-radius: 0.375rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .dropdown-menu-end {
            right: 0;
            left: auto;
        }

        /* Адаптивность для мобильных */
        @@media (max-width: 768px) {
            .dataTables_wrapper .dataTables_info,
            .dataTables_wrapper .dataTables_paginate {
                float: none !important;
                text-align: center !important;
                margin-top: 10px !important;
            }

            .dataTables_wrapper .dataTables_length {
                margin-bottom: 10px;
            }

            .btn-group {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
            }

            .btn-group .btn {
                flex: 1;
                min-width: 40px;
            }
        }
    </style>
}

@section Scripts {
    <!-- DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/select/1.7.0/js/dataTables.select.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <script>
        let table;
        let deleteUserId = null;
        const token = $('input[name="__RequestVerificationToken"]').val();

        $(document).ready(function () {
            // Инициализация DataTable
            table = $('#usersTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/ru.json'
                },
                responsive: true,
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Все"]],
                order: [[5, 'desc']], // Сортировка по дате создания
                select: {
                    style: 'multi',
                    selector: 'td:first-child'
                },
                dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                     '<"row"<"col-sm-12"tr>>' +
                     '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
                buttons: [
                    {
                        extend: 'copy',
                        className: 'btn btn-light btn-sm',
                        text: '<i class="bi bi-clipboard"></i> Копировать'
                    },
                    {
                        extend: 'excel',
                        className: 'btn btn-light btn-sm',
                        text: '<i class="bi bi-file-excel"></i> Excel'
                    },
                    {
                        extend: 'print',
                        className: 'btn btn-light btn-sm',
                        text: '<i class="bi bi-printer"></i> Печать'
                    },
                    {
                        extend: 'colvis',
                        className: 'btn btn-light btn-sm',
                        text: '<i class="bi bi-eye"></i> Колонки'
                    }
                ],
                initComplete: function () {
                    // Добавляем кнопки в верхнюю часть
                    this.api().buttons().container().appendTo('#usersTable_wrapper .col-md-6:eq(0)');

                    // Обновляем счетчики
                    updateCounters();
                },
                drawCallback: function () {
                    updateCounters();
                    updateCheckboxes();
                }
            });

            // Поиск
            $('#searchInput').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Фильтр по роли
            $('#roleFilter').on('change', function () {
                const role = $(this).val();
                if (role) {
                    table.column(3).search('\\b' + role + '\\b', true, false).draw();
                } else {
                    table.column(3).search('').draw();
                }
            });

            // Фильтр по статусу
            $('#statusFilter').on('change', function () {
                const status = $(this).val();
                if (status === 'active') {
                    table.column(4).search('Активен', true, false).draw();
                } else if (status === 'inactive') {
                    table.column(4).search('Неактивен', true, false).draw();
                } else {
                    table.column(4).search('').draw();
                }
            });

            // Выбрать все
            $('#selectAll').on('click', function () {
                const isChecked = $(this).prop('checked');
                $('.user-checkbox').prop('checked', isChecked);
                updateSelection();
            });

            // Клик по чекбоксу пользователя
            $(document).on('change', '.user-checkbox', updateSelection);

            // Экспорт в Excel
            $('#exportBtn').on('click', function (e) {
                e.preventDefault();
                window.location.href = '@Url.Action("Export", "User")';
            });
        });

        // Обновление счетчиков
        function updateCounters() {
            const shownCount = table.page.info().recordsDisplay;
            const totalCount = table.page.info().recordsTotal;

            $('#shownCount').text(shownCount);
            $('#totalCount').text(totalCount);
            $('#totalCountFooter').text(totalCount);
        }

        // Обновление чекбоксов
        function updateCheckboxes() {
            const allChecked = $('.user-checkbox:visible').length === $('.user-checkbox:visible:checked').length;
            $('#selectAll').prop('checked', allChecked).prop('indeterminate',
                $('.user-checkbox:visible:checked').length > 0 && !allChecked);
        }

        // Обновление выбора
        function updateSelection() {
            const selectedCount = $('.user-checkbox:checked').length;
            $('#selectedCount').text(selectedCount);

            if (selectedCount > 0) {
                $('#selectedActions').show();
            } else {
                $('#selectedActions').hide();
            }

            updateCheckboxes();
        }

        // Очистка выбора
        function clearSelection() {
            $('.user-checkbox').prop('checked', false);
            updateSelection();
        }

        // Получение выбранных ID пользователей
        function getSelectedUserIds() {
            return $('.user-checkbox:checked').map(function () {
                return $(this).val();
            }).get();
        }

        // Активация/деактивация пользователя
        function toggleUserActive(userId, isActive) {
            fetch(`@Url.Action("ToggleActive", "User")/${userId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast(data.message, 'danger');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('Произошла ошибка', 'danger');
            });
        }

        // Смена пароля
        function changePassword(userId) {
            const newPassword = prompt('Введите новый пароль (минимум 6 символов):');
            if (newPassword && newPassword.length >= 6) {
                fetch(`@Url.Action("ChangePassword", "User")/${userId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ newPassword: newPassword })
                })
                .then(response => response.json())
                .then(data => {
                    alert(data.message);
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Произошла ошибка');
                });
            } else if (newPassword) {
                alert('Пароль должен содержать минимум 6 символов');
            }
        }

        // Удаление пользователя
        function deleteUser(userId, userName) {
            deleteUserId = userId;
            $('#deleteUserName').text(userName);
            $('#deleteModal').modal('show');
        }

        // Подтверждение удаления
        $('#confirmDeleteBtn').on('click', function () {
            if (!deleteUserId) return;

            fetch(`@Url.Action("Delete", "User")/${deleteUserId}`, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => {
                if (response.ok) {
                    showToast('Пользователь успешно удален', 'success');
                    $('#deleteModal').modal('hide');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showToast('Ошибка при удалении пользователя', 'danger');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showToast('Произошла ошибка', 'danger');
            });
        });

        // Массовая активация
        function activateSelected() {
            const userIds = getSelectedUserIds();
            if (userIds.length === 0) {
                showToast('Выберите пользователей', 'warning');
                return;
            }

            if (confirm(`Активировать ${userIds.length} пользователей?`)) {
                fetch('@Url.Action("BulkActivate", "User")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(userIds)
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        clearSelection();
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        showToast(data.message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Произошла ошибка', 'danger');
                });
            }
        }

        // Массовая деактивация
        function deactivateSelected() {
            const userIds = getSelectedUserIds();
            if (userIds.length === 0) {
                showToast('Выберите пользователей', 'warning');
                return;
            }

            if (confirm(`Деактивировать ${userIds.length} пользователей?`)) {
                Promise.all(userIds.map(userId =>
                    fetch(`@Url.Action("ToggleActive", "User")/${userId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        }
                    })
                ))
                .then(responses => Promise.all(responses.map(r => r.json())))
                .then(results => {
                    const successCount = results.filter(r => r.success).length;
                    showToast(`Деактивировано: ${successCount} из ${userIds.length}`, 'success');
                    clearSelection();
                    setTimeout(() => location.reload(), 1000);
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Произошла ошибка', 'danger');
                });
            }
        }

        // Массовое удаление
        function deleteSelected() {
            const userIds = getSelectedUserIds();
            if (userIds.length === 0) {
                showToast('Выберите пользователей', 'warning');
                return;
            }

            if (confirm(`Удалить ${userIds.length} пользователей? Это действие нельзя отменить!`)) {
                Promise.all(userIds.map(userId =>
                    fetch(`@Url.Action("Delete", "Users")/${userId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    })
                ))
                .then(responses => {
                    showToast(`Удалено пользователей: ${userIds.length}`, 'success');
                    clearSelection();
                    setTimeout(() => location.reload(), 1000);
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('Произошла ошибка', 'danger');
                });
            }
        }

        // Функция для показа уведомлений
        function showToast(message, type = 'info') {
            // Создаем toast уведомление
            const toastId = 'toast-' + Date.now();
            const toastHtml = `
                <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            $('.toast-container').append(toastHtml);
            const toastElement = document.getElementById(toastId);
            const toast = new bootstrap.Toast(toastElement);
            toast.show();

            // Удаляем toast после скрытия
            toastElement.addEventListener('hidden.bs.toast', function () {
                $(this).remove();
            });
        }

        // Создаем контейнер для toast уведомлений
        if ($('.toast-container').length === 0) {
            $('body').append('<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1055"></div>');
        }
    </script>
}