@using Danek.BLL.DTOs
@model BookDto

@{
    ViewData["Title"] = "Delete Book";
}

<h2>Удалить книгу</h2>

<div class="mb-3">
    <h4>@Model.Title</h4>
    <p><strong>Автор:</strong> @Model.Author</p>
    <p><strong>Интро:</strong> @Model.Intro</p>
    <p><strong>Количество:</strong> @Model.Quantity</p>
</div>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Подтвердить удаление</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>
