@using Danek.BLL.Models
@using Danek.BLL.DTOs
@model PagedResult<BookDto>

@{
    ViewData["Title"] = "Books";

    var titleFilter = ViewData["TitleFilter"]?.ToString() ?? "";
    var authorFilter = ViewData["AuthorFilter"]?.ToString() ?? "";
    var inStockFilter = ViewData["InStockFilter"]?.ToString();
    var pageSize = ViewData["PageSize"]?.ToString() ?? "10";
}

<div class="d-flex justify-content-between mb-3">
    <h2>Каталог книг</h2>
    <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="title" class="form-control" placeholder="Поиск по названию" value="@titleFilter" />
    </div>
    <div class="col-auto">
        <input name="author" class="form-control" placeholder="Автор" value="@authorFilter" />
    </div>
    <div class="col-auto">
        <select name="inStock" class="form-select">
            <option value="">Все</option>
            <option value="true" selected="@(inStockFilter == "True" ? "selected" : null)">В наличии</option>
            <option value="false" selected="@(inStockFilter == "False" ? "selected" : null)">Нет в наличии</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="pageSize" class="form-select">
            <option value="10" selected="@(pageSize == "10" ? "selected" : null)">10</option>
            <option value="20" selected="@(pageSize == "20" ? "selected" : null)">20</option>
            <option value="50" selected="@(pageSize == "50" ? "selected" : null)">50</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-secondary" type="submit">Применить</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sort="title">Название</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort="author">Автор</a>
            </th>
            <th>Интро</th>
            <th>
                <a asp-action="Index" asp-route-sort="quantity">Количество</a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort="created_desc">Дата добавления</a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var b in Model.Items)
    {
        <tr>
            <td>@b.Title</td>
            <td>@b.Author</td>
            <td>@b.Intro</td>
            <td>@b.Quantity</td>
            <td></td>
            <td>
                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<nav aria-label="Page navigation">
    <ul class="pagination">
        @{
            var totalPages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize);
            var cur = Model.Page;
        }
        <li class="page-item @(cur == 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(cur-1)">Previous</a>
        </li>
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == cur ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(cur == totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(cur+1)">Next</a>
        </li>
    </ul>
</nav>
